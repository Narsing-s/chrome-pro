{
  "name": "chrome-pro-desktop",
  "version": "1.0.0",
  "description": "Chrome Pro — a fast, private desktop browser",
  "author": "Narsing-s",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.chromepro.browser",
    "productName": "Chrome Pro",
    "files": ["**/*", "!node_modules/.cache/**"],
    "extraResources": [{"from":"browser-ui.html","to":"browser-ui.html"}],
    "win": {"target":["nsis","portable"]},
    "mac": {"target":["dmg"]},
    "linux": {"target":["AppImage"]}
  }
}
